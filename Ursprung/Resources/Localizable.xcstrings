{
  "sourceLanguage": "en",
  "strings": {
    "%@ (Recommended)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (empfohlen)"
          }
        }
      }
    },
    "%@ fps": {
      "shouldTranslate": false
    },
    "%@ needs BIOS files that are missing: %@. Import them in Settings → BIOS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ benötigt BIOS-Dateien, die fehlen: %2$@. Importiere sie unter Einstellungen → BIOS."
          }
        }
      }
    },
    "%lld games": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Spiele"
          }
        }
      }
    },
    "%lld games found, %lld new, %lld removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Spiele gefunden, %2$lld neu, %3$lld entfernt."
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld"
          }
        }
      }
    },
    "1 game": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Spiel"
          }
        }
      }
    },
    "Activity": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivität"
          }
        }
      }
    },
    "Add Folder to Library…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner zur Bibliothek hinzufügen …"
          }
        }
      }
    },
    "Add Folder…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner hinzufügen …"
          }
        }
      }
    },
    "Add a folder with your games to get started. Ursprung recognises the system from file types and folder names, and fetches covers and details from ScreenScraper.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Ordner mit deinen Spielen hinzu, um loszulegen. Ursprung erkennt das System anhand von Dateityp und Ordnername und lädt Cover und Details von ScreenScraper."
          }
        }
      }
    },
    "Add to Favorites": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Favoriten hinzufügen"
          }
        }
      }
    },
    "Add to Library": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Bibliothek hinzufügen"
          }
        }
      }
    },
    "Added": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügt"
          }
        }
      }
    },
