    "Choose folders that contain your games. Sub folders named after a system (e.g. “SNES” or “PSX”) help Ursprung identify disc images.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Ordner mit deinen Spielen. Unterordner, die nach einem System benannt sind (z. B. „SNES“ oder „PSX“), helfen Ursprung, Disc-Images zuzuordnen."
          }
        }
      }
    },
