          }
        }
      }
    },
    "BIOS": {
      "shouldTranslate": false
    },
    "Battery Saves": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielstände (SRAM)"
          }
        }
      }
    },
