      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cores"
          }
        }
      }
    },
    "Cores are downloaded automatically from the libretro buildbot the first time you play a game. They are separate open source projects with their own licenses.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cores werden beim ersten Spielstart automatisch vom libretro-Buildbot geladen. Es sind eigenständige Open-Source-Projekte mit eigenen Lizenzen."
          }
        }
      }
    },
