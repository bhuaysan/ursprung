      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhalten"
          }
        }
      }
    },
    "CRC32": {
      "shouldTranslate": false
    },
    "Change Disc (%lld/%lld)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Disc wechseln (%1$lld/%2$lld)"
          }
        }
      }
    },
    "Choose folders that contain your games. Sub folders named after a system (e.g. “SNES” or “PSX”) help Ursprung identify disc images.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Ordner mit deinen Spielen. Unterordner, die nach einem System benannt sind (z. B. „SNES“ oder „PSX“), helfen Ursprung, Disc-Images zuzuordnen."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        }
      }
    },
    "Controller": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Controller"
          }
        }
      }
    },
    "Controllers are mapped by button position: the bottom face button is B, the right one is A — like on a Super Nintendo pad. The Home button opens the game menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Controller werden nach Tastenposition belegt: Die untere Aktionstaste ist B, die rechte A – wie beim Super-Nintendo-Controller. Die Home-Taste öffnet das Spielmenü."
          }
        }
      }
    },
    "Controls": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuerung"
          }
        }
      }
    },
